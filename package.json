{
  "name": "grip",
  "productName": "Grip",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build:native && vite build",
    "build:native": "cd native && napi build --platform --release --dts index.d.ts --no-js",
    "start": "electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "server": "node server/server.ts",
    "pretest": "node -e \"require('electron')\"",
    "test": "node --test 'src/**/*.test.ts' 'electron/**/*.test.ts' 'server/**/*.test.ts' 'scripts/**/*.test.ts'",
    "package": "npm run build && electron-builder --mac --publish never && if [ -n \"$APPLE_KEYCHAIN_PROFILE\" ]; then dmg=release/Grip-$npm_package_version-arm64.dmg && xcrun notarytool submit \"$dmg\" --keychain-profile \"$APPLE_KEYCHAIN_PROFILE\" --wait && xcrun stapler staple \"$dmg\"; fi"
  },
  "build": {
    "appId": "com.bestboyhq.grip",
    "forceCodeSigning": true,
    "productName": "Grip",
    "copyright": "Copyright © 2026 Grip",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "!electron/**/*.test.ts",
      "src/shared/**/*.ts",
      "src/engine/**/*.ts",
      "src/assets/**/*.ts",
      "!src/**/*.test.ts",
      "server/client.ts",
      "dist/**/*",
      "native/studio.*.node"
    ],
    "asarUnpack": [
      "native/*.node"
    ],
    "protocols": [
      {
        "name": "Grip",
        "schemes": [
          "grip"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov"
        ],
        "name": "Video",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/Grip.icon",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": "\\.pak$",
      "minimumSystemVersion": "15.0",
      "extendInfo": {
        "NSCameraUsageDescription": "Grip records your camera next to your screen when you pick a camera.",
        "NSMicrophoneUsageDescription": "Grip records your voice when you pick a microphone.",
        "NSAudioCaptureUsageDescription": "Grip records the sound your Mac plays when system audio is on.",
        "NSBluetoothAlwaysUsageDescription": "Grip uses Bluetooth only for devices you connect, like headphones or a microphone.",
        "NSBluetoothPeripheralUsageDescription": "Grip uses Bluetooth only for devices you connect, like headphones or a microphone.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Grip Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.bestboyhq.grip.project"
            ],
            "LSTypeIsPackage": true,
            "CFBundleTypeIconFile": "icon.icns"
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.bestboyhq.grip.project",
            "UTTypeDescription": "Grip Project",
            "UTTypeConformsTo": [
              "com.apple.package",
              "public.composite-content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "grip"
              ]
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "Grip",
      "sign": true
    },
    "publish": {
      "provider": "github",
      "owner": "bestboyhq",
      "repo": "grip"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "electron-updater": "^6.8.9",
    "gifenc": "1.0.3",
    "mediabunny": "^1.61.1",
    "perfect-freehand": "1.2.3",
    "signalsmith-stretch": "1.3.2"
  }
}
