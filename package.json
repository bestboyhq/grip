{
  "name": "studio",
  "productName": "Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build:native && vite build",
    "build:native": "cd native && napi build --platform --release --dts index.d.ts --no-js",
    "start": "electron .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test 'src/**/*.test.ts' 'electron/**/*.test.ts'"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "electron": "^44.5.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "mediabunny": "^1.61.1"
  }
}
