{
	"name": "grip-site",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"routes": [{ "pattern": "bestboy.dev/grip*", "zone_name": "bestboy.dev" }],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": true,
	},
}
